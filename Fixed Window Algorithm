import java.util.concurrent.ConcurrentHashMap
fun main() {
	val config = RateLimiterConfig(maxRequest = 3,windowSizeInMillis = 1000L )
    val store = InMemoryWindowStore()
    
    val fixedRateLimiter = FixedRateLimiter(config,store,SystemClock)
    val handler = RequestHandler(fixedRateLimiter)
    
    repeat(5){i->
        println("Request ${i+1}: ${handler.handle("user1")}")
    }
    Thread.sleep(1000)
	println("Request after reset: ${handler.handle("user1")}")
}

//models
data class RateLimiterConfig(
    val maxRequest:Int,
    val windowSizeInMillis:Long
)

data class Window(
    val count:Int,
    val windowStart:Long
)

//storage
interface WindowStore{
    fun compute(clientId:String,window:(Window?) -> Window) : Window
}

class InMemoryWindowStore:WindowStore{
   val windowMap = ConcurrentHashMap<String,Window>()
   override fun compute(clientId:String,update:(Window?) -> Window) : Window {
       return windowMap.compute(clientId){_,existing->
         update(existing)
       }!!
   }
}

// clock
interface Clock{
    fun nowMillis(): Long
}

object SystemClock : Clock{
    override fun nowMillis() : Long = System.currentTimeMillis()
}

// limiter 
interface RateLimiter{
    fun allowRequest(clientId:String) : Boolean
}

class FixedRateLimiter(
    val config : RateLimiterConfig,
    val store: WindowStore,
    val clock: Clock
): RateLimiter{
    
    override fun allowRequest(clientId:String):Boolean{
        var isAllowed = false
        val now = clock.nowMillis()
        val window = now - (now % config.windowSizeInMillis)
        
        store.compute(clientId){existing ->
          val current = if(existing == null || existing.windowStart != window) Window(count = 0,windowStart = window)
            else existing
            
            if(current.count < config.maxRequest){
                isAllowed = true
                current.copy(count = current.count + 1)
            }else{
                current
            }
        }
        
        return isAllowed
    }
    
}

// handler
class RequestHandler(val rateLimiter:RateLimiter){
    fun handle(clientId:String): String{
        return if(rateLimiter.allowRequest(clientId)) "OK"
        else "429 too many request"
    }
}

